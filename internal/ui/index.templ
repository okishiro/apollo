package ui

templ Index() {
    <script src="https://unpkg.com/htmx.org@1.9.10"></script>
    
    <div id="form-container">
        <input type="text" id="acc-name" placeholder="Enter Account Name" />
        
        <form 
            hx-post="/movie/" 
            hx-target="#movie-list" 
            hx-swap="afterbegin"
            hx-on="htmx:configRequest: event.detail.path = '/movie/' + document.getElementById('acc-name').value"
        >
            <input type="text" name="name" placeholder="Movie Title" />
            <input type="text" name="comment" placeholder="Comment" />
            <button type="submit">Add Movie</button>
        </form>
    </div>

    <div id="movie-list"></div>
}